# Instrumented TrashCat (Endless Runner) Windows standalone build
GAME_EXE=App/TrashCatWindows/TrashCat.exe

# AltTester driver (connects to AltTester Desktop server — keep Desktop open for SDK 2.x)
ALT_DRIVER_HOST=127.0.0.1
ALT_DRIVER_PORT=13000

# Seconds to wait after launching the game before tests connect
# GAME_LAUNCH_WAIT_SECS=15

# Auto-launch game before tests (1 = yes)
LAUNCH_GAME=1

# Frame capture interval while tests run (ms)
RECORD_FRAME_MS=500

# Encode frames to MP4 with ffmpeg after the run (1 = yes)
RECORD_VIDEO=1

# Optional: ffmpeg gdigrab full desktop instead of AltTester frames (0 = use frames)
FFMPEG_DESKTOP_CAPTURE=0
